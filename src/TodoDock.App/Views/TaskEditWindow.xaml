<Window x:Class="TodoDock.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Width="440" SizeToContent="Height" WindowStartupLocation="CenterScreen" Topmost="True"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <Border Margin="14" CornerRadius="12" Background="#FF202229" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
        <StackPanel Margin="20,14,20,18">
            <DockPanel MouseLeftButtonDown="OnDrag" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource GhostButton}" Click="OnCancel" ToolTip="Закрыть"/>
                <TextBlock Text="Изменить задачу" FontSize="16" FontWeight="SemiBold"/>
            </DockPanel>

            <TextBlock Text="Название" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,4"/>
            <TextBox x:Name="TitleBox" Style="{StaticResource FlatBox}" Padding="10,8" FontSize="14"/>

            <TextBlock Text="Заметка" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,4"/>
            <TextBox x:Name="NoteBox" Style="{StaticResource FlatBox}" Padding="10,8" Height="64"
                     AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

            <TextBlock Text="Папка" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6"/>
            <WrapPanel x:Name="FolderPanel"/>

            <TextBlock Text="Приоритет" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,6"/>
            <WrapPanel x:Name="PriorityPanel"/>

            <TextBlock Text="Срок — в это время сработает напоминание" Foreground="{StaticResource MutedBrush}" Margin="0,8,0,6"/>
            <Grid>
                <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="10"/><ColumnDefinition Width="84"/></Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="DueDate" Style="{StaticResource FlatBox}" Padding="10,8" x:FieldModifier="private"/>
                    <TextBlock Style="{StaticResource PlaceholderText}" Text="дд.мм.гггг" IsHitTestVisible="False" x:Name="DatePlaceholder"/>
                </Grid>
                <TextBox x:Name="DueTime" Grid.Column="2" Style="{StaticResource FlatBox}" Padding="10,8" Text="09:00" ToolTip="ЧЧ:ММ" HorizontalContentAlignment="Center"/>
            </Grid>
            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                <Button Content="Сегодня" Style="{StaticResource ChipButton}" Click="OnToday"/>
                <Button Content="Завтра" Style="{StaticResource ChipButton}" Click="OnTomorrow"/>
                <Button Content="Через неделю" Style="{StaticResource ChipButton}" Click="OnWeek"/>
                <Button Content="Без срока" Style="{StaticResource ChipButton}" Click="OnClearDue"/>
            </StackPanel>

            <TextBlock Text="Повтор" Foreground="{StaticResource MutedBrush}" Margin="0,12,0,6"/>
            <WrapPanel x:Name="RepeatPanel"/>

            <CheckBox x:Name="TgBox" Margin="0,6,0,0" HorizontalAlignment="Left">
                <TextBlock Text="Дублировать в Telegram" Margin="8,0,0,0" VerticalAlignment="Center"/>
            </CheckBox>

            <TextBlock x:Name="Error" Foreground="{StaticResource ErrorBrush}" TextWrapping="Wrap" Margin="0,10,0,0" Visibility="Collapsed"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
