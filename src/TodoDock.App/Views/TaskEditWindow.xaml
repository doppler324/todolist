<Window x:Class="TodoDock.Views.TaskEditWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Изменить задачу" Width="400" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" Background="#F3F3F3" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18">
        <TextBlock Text="Название"/>
        <TextBox x:Name="TitleBox" Margin="0,4,0,10" Padding="6"/>

        <TextBlock Text="Заметка"/>
        <TextBox x:Name="NoteBox" Margin="0,4,0,10" Padding="6" Height="60" AcceptsReturn="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"/>

        <Grid Margin="0,0,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="12"/><ColumnDefinition/></Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Папка"/>
                <ComboBox x:Name="FolderBox" Margin="0,4,0,0" DisplayMemberPath="Name"/>
            </StackPanel>
            <StackPanel Grid.Column="2">
                <TextBlock Text="Приоритет"/>
                <ComboBox x:Name="PriorityBox" Margin="0,4,0,0"/>
            </StackPanel>
        </Grid>

        <TextBlock Text="Срок (напоминание сработает в это время)"/>
        <Grid Margin="0,4,0,10">
            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition Width="8"/><ColumnDefinition Width="70"/><ColumnDefinition Width="8"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
            <DatePicker x:Name="DueDate"/>
            <TextBox x:Name="DueTime" Grid.Column="2" Padding="6" Text="09:00" ToolTip="ЧЧ:ММ"/>
            <Button Grid.Column="4" Content="Убрать срок" Padding="8,4" Click="OnClearDue"/>
        </Grid>

        <TextBlock Text="Повтор"/>
        <ComboBox x:Name="RepeatBox" Margin="0,4,0,8" DisplayMemberPath="Name"/>
        <CheckBox x:Name="TgBox" Content="Дублировать в Telegram" Margin="0,2,0,8"/>
        <TextBlock x:Name="Error" Foreground="#C42B1C" Margin="0,0,0,6" Visibility="Collapsed"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Сохранить" IsDefault="True" Padding="18,6" Margin="0,0,8,0" Click="OnSave"/>
            <Button Content="Отмена" IsCancel="True" Padding="18,6"/>
        </StackPanel>
    </StackPanel>
</Window>
