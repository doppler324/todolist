<Window x:Class="TodoDock.Views.HandleWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True" ShowActivated="False"
        Width="40" Height="110">
    <Grid>
        <Border x:Name="Pill" HorizontalAlignment="Right" VerticalAlignment="Center" Height="96" Width="8" Cursor="Hand"
                Background="{StaticResource AccentBrush}" CornerRadius="8,0,0,8"
                MouseLeftButtonUp="OnClick" MouseEnter="OnEnter" MouseLeave="OnLeave">
            <Border.Effect><DropShadowEffect Color="#4F8CFF" BlurRadius="14" ShadowDepth="0" Opacity="0.6"/></Border.Effect>
            <TextBlock x:Name="Chevron" Text="‹" Foreground="White" FontSize="22" Opacity="0"
                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
        </Border>
        <Border x:Name="Badge" Visibility="Collapsed" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,0,0"
                Background="#FF4D5E" CornerRadius="10" MinWidth="20" Height="20" IsHitTestVisible="False">
            <TextBlock x:Name="BadgeText" Foreground="White" FontSize="11" FontWeight="SemiBold"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Margin="5,0"/>
        </Border>
    </Grid>
</Window>
