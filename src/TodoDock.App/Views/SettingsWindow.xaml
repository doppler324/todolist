<Window x:Class="TodoDock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        Width="480" SizeToContent="Height" WindowStartupLocation="CenterScreen" Topmost="True"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <Border Margin="14" CornerRadius="12" Background="#FF202229" BorderBrush="#22FFFFFF" BorderThickness="1">
        <Border.Effect><DropShadowEffect BlurRadius="24" ShadowDepth="4" Opacity="0.5"/></Border.Effect>
        <StackPanel Margin="20,14,20,18">
            <DockPanel MouseLeftButtonDown="OnDrag" Background="Transparent">
                <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource GhostButton}" Click="OnCancel" ToolTip="Закрыть"/>
                <TextBlock Text="Настройки — Telegram" FontSize="16" FontWeight="SemiBold"/>
            </DockPanel>

            <CheckBox x:Name="EnabledBox" Margin="0,14,0,0" HorizontalAlignment="Left">
                <TextBlock Text="Дублировать уведомления в Telegram" FontWeight="SemiBold" Margin="8,0,0,0"/>
            </CheckBox>

            <Border Margin="0,12,0,0" Padding="12,10" CornerRadius="8" Background="{StaticResource CardBrush}">
                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}" FontSize="12" LineHeight="19">
                    1. В Telegram откройте @BotFather → /newbot → скопируйте токен.<LineBreak/>
                    2. Вставьте токен ниже и нажмите «Проверить».<LineBreak/>
                    3. Откройте своего бота, нажмите Start (или напишите /start).<LineBreak/>
                    4. Нажмите «Привязать чат».
                </TextBlock>
            </Border>

            <TextBlock Text="Токен бота" Foreground="{StaticResource MutedBrush}" Margin="0,14,0,4"/>
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Проверить" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="OnCheck"/>
                <PasswordBox x:Name="TokenBox" Padding="10,8"/>
            </DockPanel>
            <TextBlock x:Name="TokenStatus" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>

            <DockPanel Margin="0,14,0,0">
                <Button DockPanel.Dock="Right" Content="Привязать чат" Style="{StaticResource SecondaryButton}" Click="OnBind"/>
                <TextBlock x:Name="ChatStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0" Foreground="{StaticResource MutedBrush}"/>
            </DockPanel>

            <Button Content="Отправить тестовое сообщение" Style="{StaticResource SecondaryButton}" Margin="0,14,0,0" HorizontalAlignment="Left" Click="OnTest"/>
            <TextBlock x:Name="TestStatus" Margin="0,6,0,0" TextWrapping="Wrap" Foreground="{StaticResource MutedBrush}"/>

            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
                <Button Content="Отмена" Style="{StaticResource SecondaryButton}" Margin="0,0,8,0" IsCancel="True" Click="OnCancel"/>
                <Button Content="Сохранить" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="OnSave"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
