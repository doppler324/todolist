<Window x:Class="TodoDock.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Настройки — Telegram" Width="460" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen" Topmost="True" Background="#F3F3F3" FontFamily="Segoe UI" FontSize="13">
    <StackPanel Margin="18">
        <CheckBox x:Name="EnabledBox" Content="Дублировать уведомления в Telegram" FontWeight="SemiBold"/>

        <TextBlock Margin="0,12,0,0" TextWrapping="Wrap" Foreground="#555">
            1. В Telegram откройте @BotFather → /newbot → скопируйте токен.<LineBreak/>
            2. Вставьте токен ниже и нажмите «Проверить».<LineBreak/>
            3. Откройте своего бота, нажмите Start (или напишите /start).<LineBreak/>
            4. Нажмите «Привязать чат».
        </TextBlock>

        <TextBlock Text="Токен бота" Margin="0,12,0,4"/>
        <DockPanel>
            <Button DockPanel.Dock="Right" Content="Проверить" Padding="12,5" Margin="8,0,0,0" Click="OnCheck"/>
            <PasswordBox x:Name="TokenBox" Padding="6"/>
        </DockPanel>
        <TextBlock x:Name="TokenStatus" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <DockPanel Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Привязать чат" Padding="12,5" Click="OnBind"/>
            <TextBlock x:Name="ChatStatus" VerticalAlignment="Center" TextWrapping="Wrap" Margin="0,0,8,0"/>
        </DockPanel>

        <Button Content="Отправить тестовое сообщение" Margin="0,12,0,0" Padding="12,5" HorizontalAlignment="Left" Click="OnTest"/>
        <TextBlock x:Name="TestStatus" Margin="0,4,0,0" TextWrapping="Wrap"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="Сохранить" IsDefault="True" Padding="18,6" Margin="0,0,8,0" Click="OnSave"/>
            <Button Content="Отмена" IsCancel="True" Padding="18,6"/>
        </StackPanel>
    </StackPanel>
</Window>
