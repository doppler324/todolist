<Window x:Class="TodoDock.Views.DesktopWidgetWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="NoResize"
        ShowInTaskbar="False" Topmost="False" ShowActivated="False" SizeToContent="Height" Width="340"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="13">
    <Border Margin="10" CornerRadius="14" Background="#D9202229" BorderBrush="#22FFFFFF" BorderThickness="1" Padding="14,10,10,12">
        <Border.Effect><DropShadowEffect BlurRadius="16" ShadowDepth="2" Opacity="0.35"/></Border.Effect>
        <DockPanel>
            <DockPanel DockPanel.Dock="Top" Background="Transparent" Cursor="SizeAll" MouseLeftButtonDown="OnDrag" ToolTip="Перетащите, чтобы переместить окно">
                <TextBlock Text="📋 Задачи" FontWeight="SemiBold" FontSize="15"/>
            </DockPanel>
            <ScrollViewer x:Name="Scroller" VerticalScrollBarVisibility="Auto" Margin="0,8,0,0" Padding="0,0,6,0">
                <ItemsControl ItemsSource="{Binding WidgetFolders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,0,0,10">
                                <StackPanel Orientation="Horizontal" Margin="0,2,0,4">
                                    <TextBlock Text="{Binding Icon}" Margin="0,0,6,0" FontSize="12"/>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                                </StackPanel>
                                <TextBlock Text="Нет задач" Foreground="#6F7785" FontSize="12" Margin="22,0,0,0">
                                    <TextBlock.Style><Style TargetType="TextBlock">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                        <Style.Triggers><DataTrigger Binding="{Binding Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                                    </Style></TextBlock.Style>
                                </TextBlock>
                                <ItemsControl ItemsSource="{Binding Tasks}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <DockPanel Margin="0,3">
                                                <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Top" Margin="0,2,10,0"/>
                                                <StackPanel>
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                            </DataTrigger>
                                                        </Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding Subtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#FF7A86"/></DataTrigger>
                                                        </Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </DockPanel>
    </Border>
</Window>
