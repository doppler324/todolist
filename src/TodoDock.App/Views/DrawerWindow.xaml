<Window x:Class="TodoDock.Views.DrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Width="380" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" PreviewKeyDown="OnKey" Deactivated="OnDeactivated" Visibility="Hidden">
    <Grid Margin="16">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="📋 TodoDock" FontSize="16" FontWeight="SemiBold"/>
            <ToggleButton x:Name="PinButton" Content="📌" DockPanel.Dock="Right" Background="Transparent"
                          BorderThickness="0" Foreground="{StaticResource MutedBrush}" ToolTip="Закрепить панель"/>
        </DockPanel>
        <TextBox x:Name="QuickAdd" Grid.Row="1" Margin="0,12,0,8" Padding="10"
                 Background="{StaticResource CardBrush}" Foreground="{StaticResource TextBrush}"
                 BorderBrush="{StaticResource AccentBrush}" BorderThickness="0,0,0,2" FontSize="14"/>
        <TextBlock Grid.Row="2" Text="Здесь будут папки и задачи (этап M2)" Foreground="{StaticResource MutedBrush}"
                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
    </Grid>
</Window>
