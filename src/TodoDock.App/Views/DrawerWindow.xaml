<Window x:Class="TodoDock.Views.DrawerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:TodoDock.Views"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False" Topmost="True"
        Width="380" Background="{StaticResource PanelBrush}" Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" PreviewKeyDown="OnKey" Deactivated="OnDeactivated" Visibility="Hidden">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V"/>
        <local:EmptyToVisibleConverter x:Key="EmptyToVisible"/>
        <Style x:Key="FlatBox" TargetType="TextBox">
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Foreground" Value="{StaticResource TextBrush}"/>
            <Setter Property="CaretBrush" Value="White"/>
            <Setter Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
            <Setter Property="BorderThickness" Value="0,0,0,2"/>
            <Setter Property="Padding" Value="8,6"/>
        </Style>
        <Style x:Key="GhostButton" TargetType="Button">
            <Setter Property="Background" Value="Transparent"/><Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/><Setter Property="Cursor" Value="Hand"/>
        </Style>
        <Style TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border x:Name="box" Width="18" Height="18" CornerRadius="9" BorderThickness="1.5" BorderBrush="#9AA3B2" Background="Transparent">
                            <TextBlock x:Name="mark" Text="✓" Foreground="White" FontSize="11" FontWeight="Bold"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="box" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                                <Setter TargetName="mark" Property="Visibility" Value="Visible"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="box" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style TargetType="ScrollBar">
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ScrollBar">
                        <Grid Width="6" Background="Transparent">
                            <Track x:Name="PART_Track" IsDirectionReversed="True">
                                <Track.DecreaseRepeatButton><RepeatButton Command="ScrollBar.PageUpCommand" Opacity="0"/></Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton><RepeatButton Command="ScrollBar.PageDownCommand" Opacity="0"/></Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb><Thumb.Template><ControlTemplate TargetType="Thumb">
                                        <Border CornerRadius="3" Background="#44FFFFFF" Margin="1,0"/>
                                    </ControlTemplate></Thumb.Template></Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="TabButton" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="Margin" Value="0,0,6,0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="pill" CornerRadius="14" Padding="13,5" Background="Transparent">
                            <ContentPresenter TextElement.Foreground="{TemplateBinding Foreground}"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{StaticResource AccentBrush}"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="pill" Property="Opacity" Value="0.85"/></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <Style x:Key="PlaceholderText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
            <Setter Property="IsHitTestVisible" Value="False"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Margin" Value="12,0,0,0"/>
        </Style>
        <DataTemplate x:Key="TaskCard">
                                        <Border Margin="14,2,0,2" Padding="0" CornerRadius="8" Background="{StaticResource CardBrush}" AllowDrop="True"
                                                PreviewMouseLeftButtonDown="OnTaskMouseDown" PreviewMouseMove="OnTaskMouseMove" Drop="OnDropOnTask"
                                                MouseLeftButtonUp="OnTaskMouseUp">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="Изменить…" Click="OnEditMenu"/>
                                                    <MenuItem Header="Удалить" Command="{Binding DataContext.DeleteTaskCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="4" CornerRadius="8,0,0,8" Background="{Binding PriorityColor}"/>
                                                <CheckBox IsChecked="{Binding IsDone}" VerticalAlignment="Center" Margin="10,0,8,0"/>
                                                <StackPanel Margin="0,8,10,8">
                                                    <TextBlock Text="{Binding Title}" TextWrapping="Wrap" MouseLeftButtonDown="OnTaskTitleClick">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDone}" Value="True">
                                                                <Setter Property="TextDecorations" Value="Strikethrough"/>
                                                                <Setter Property="Foreground" Value="{StaticResource MutedBrush}"/>
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                        </Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBox Text="{Binding Title, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FlatBox}"
                                                             Visibility="{Binding IsEditing, Converter={StaticResource B2V}}"
                                                             IsVisibleChanged="OnEditBoxVisible" LostFocus="OnTaskEditLostFocus" KeyDown="OnTaskEditKey"/>
                                                    <TextBlock Text="{Binding Subtitle}" FontSize="11" Foreground="{StaticResource MutedBrush}">
                                                        <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                            <DataTrigger Binding="{Binding Subtitle}" Value=""><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                                            <DataTrigger Binding="{Binding IsOverdue}" Value="True"><Setter Property="Foreground" Value="#FF7A86"/></DataTrigger>
                                                        </Style.Triggers></Style></TextBlock.Style>
                                                    </TextBlock>
                                                </StackPanel>
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
    </Window.Resources>
    <Grid Margin="16,14,12,12">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="📋 TodoDock" FontSize="16" FontWeight="SemiBold"/>
            <Button Content="⚙" DockPanel.Dock="Right" Style="{StaticResource GhostButton}" ToolTip="Настройки (Telegram)" Margin="0,0,6,0" Click="OnSettings"/>
            <ToggleButton x:Name="PinButton" Content="📌" DockPanel.Dock="Right" HorizontalAlignment="Right" Background="Transparent"
                          BorderThickness="0" Foreground="{StaticResource MutedBrush}" ToolTip="Закрепить панель"/>
        </DockPanel>

        <Grid Grid.Row="1" Margin="0,12,4,10">
            <TextBox x:Name="QuickAdd" FontSize="14" Style="{StaticResource FlatBox}" Padding="12,10"
                     Text="{Binding QuickText, UpdateSourceTrigger=PropertyChanged}"
                     ToolTip="Пример: Купить хлеб #Дом !высокий @завтра 18:00 *ежедневно">
                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddTaskCommand}"/></TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource PlaceholderText}" Text="Новая задача…  #папка !высокий @завтра 18:00">
                                <TextBlock.Visibility><Binding Path="QuickText" Converter="{StaticResource EmptyToVisible}"/></TextBlock.Visibility>
            </TextBlock>
        </Grid>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,0,0,8">
            <RadioButton x:Name="TabTasks" Content="Задачи" Style="{StaticResource TabButton}" IsChecked="True" Tag="0" Checked="OnTab"/>
            <RadioButton x:Name="TabNotifs" Content="Уведомления" Style="{StaticResource TabButton}" Tag="1" Checked="OnTab"/>
            <RadioButton x:Name="TabToday" Content="Сегодня" Style="{StaticResource TabButton}" Tag="2" Checked="OnTab"/>
        </StackPanel>

        <Grid Grid.Row="3">
            <!-- Задачи -->
            <ScrollViewer x:Name="PageTasks" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0">
                <ItemsControl ItemsSource="{Binding Folders}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <StackPanel Margin="0,4">
                                <Border Background="Transparent" Padding="6,7" CornerRadius="8" AllowDrop="True" Cursor="Hand"
                                        MouseLeftButtonUp="OnFolderClick" Drop="OnDropOnFolder">
                                    <Border.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="Переименовать" Command="{Binding DataContext.RenameFolderStartCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                            <MenuItem Header="Удалить папку" Command="{Binding DataContext.DeleteFolderCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding}"/>
                                        </ContextMenu>
                                    </Border.ContextMenu>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Left" Width="16" VerticalAlignment="Center" Foreground="{StaticResource MutedBrush}" FontSize="11">
                                            <TextBlock.Style><Style TargetType="TextBlock">
                                                <Setter Property="Text" Value="▾"/>
                                                <Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="False"><Setter Property="Text" Value="▸"/></DataTrigger></Style.Triggers>
                                            </Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBlock Text="{Binding Icon}" Margin="0,0,8,0" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Count}" DockPanel.Dock="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" VerticalAlignment="Center"/>
                                        <TextBlock Text="{Binding Name}" FontWeight="SemiBold" FontSize="15" VerticalAlignment="Center">
                                            <TextBlock.Style><Style TargetType="TextBlock"><Style.Triggers>
                                                <DataTrigger Binding="{Binding IsEditing}" Value="True"><Setter Property="Visibility" Value="Collapsed"/></DataTrigger>
                                            </Style.Triggers></Style></TextBlock.Style>
                                        </TextBlock>
                                        <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" Style="{StaticResource FlatBox}"
                                                 Visibility="{Binding IsEditing, Converter={StaticResource B2V}}"
                                                 IsVisibleChanged="OnEditBoxVisible" LostFocus="OnFolderEditLostFocus" KeyDown="OnFolderEditKey"/>
                                    </DockPanel>
                                </Border>
                                <ItemsControl ItemsSource="{Binding Tasks}" ItemTemplate="{StaticResource TaskCard}"
                                              Visibility="{Binding IsExpanded, Converter={StaticResource B2V}}"/>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Уведомления -->
            <ScrollViewer x:Name="PageNotifs" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock x:Name="NotifEmpty" Text="Нет активных уведомлений" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,40,0,0"/>
                    <ItemsControl x:Name="NotifList">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border Margin="0,4" Padding="12,10" CornerRadius="8" Background="{StaticResource CardBrush}" BorderBrush="#FF9F43" BorderThickness="3,0,0,0">
                                    <StackPanel>
                                        <DockPanel>
                                            <Button DockPanel.Dock="Right" Content="✕" Style="{StaticResource GhostButton}" ToolTip="Закрыть" Click="OnNotifClose"/>
                                            <TextBlock Text="{Binding Title, StringFormat='🔔 {0}'}" FontWeight="SemiBold" TextWrapping="Wrap"/>
                                        </DockPanel>
                                        <TextBlock Text="{Binding Body}" Foreground="{StaticResource MutedBrush}" FontSize="11" Margin="0,1,0,0"/>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button Content="5 мин" Tag="5" Click="OnNotifSnooze" Padding="8,3" Margin="0,0,4,0"/>
                                            <Button Content="1 час" Tag="60" Click="OnNotifSnooze" Padding="8,3" Margin="0,0,4,0"/>
                                            <Button Content="Завтра" Tag="tomorrow" Click="OnNotifSnooze" Padding="8,3" Margin="0,0,4,0"/>
                                            <Button Content="Выполнено" Click="OnNotifDone" Padding="8,3" Background="{StaticResource AccentBrush}" Foreground="White" BorderThickness="0"/>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </ScrollViewer>

            <!-- Сегодня -->
            <ScrollViewer x:Name="PageToday" VerticalScrollBarVisibility="Auto" Padding="0,0,4,0" Visibility="Collapsed">
                <StackPanel>
                    <TextBlock Text="На сегодня задач нет" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" Margin="0,40,0,0">
                        <TextBlock.Style><Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers><DataTrigger Binding="{Binding TodayTasks.Count}" Value="0"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
                        </Style></TextBlock.Style>
                    </TextBlock>
                    <ItemsControl ItemsSource="{Binding TodayTasks}" ItemTemplate="{StaticResource TaskCard}"/>
                </StackPanel>
            </ScrollViewer>
        </Grid>

        <Grid Grid.Row="4" Margin="0,8,4,0">
            <TextBox Style="{StaticResource FlatBox}" Padding="12,8" Text="{Binding NewFolderName, UpdateSourceTrigger=PropertyChanged}">
                <TextBox.InputBindings><KeyBinding Key="Return" Command="{Binding AddFolderCommand}"/></TextBox.InputBindings>
            </TextBox>
            <TextBlock Style="{StaticResource PlaceholderText}" Text="＋ Новая папка">
                <TextBlock.Visibility><Binding Path="NewFolderName" Converter="{StaticResource EmptyToVisible}"/></TextBlock.Visibility>
            </TextBlock>
        </Grid>
    </Grid>
</Window>
