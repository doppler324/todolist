<Application x:Class="TodoDock.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <Color x:Key="AccentColor">#4F8CFF</Color>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="PanelBrush" Color="#F0202229"/>
        <SolidColorBrush x:Key="CardBrush" Color="#14FFFFFF"/>
        <SolidColorBrush x:Key="TextBrush" Color="#F2F4F8"/>
        <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B2"/>
    </Application.Resources>
</Application>
